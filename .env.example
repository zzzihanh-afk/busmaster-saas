# BUSMASTER SaaS - Environment Variables
# Copy this file to .env and provide your Supabase project credentials

# Supabase API (Obtained from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Application Configuration
VITE_APP_NAME="BUSMASTER"
VITE_DEFAULT_CURRENCY="BDT"
VITE_DEFAULT_CURRENCY_SYMBOL="৳"
VITE_TIMEZONE="Asia/Dhaka"
VITE_DATE_FORMAT="DD-MM-YYYY"
